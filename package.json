{
  "name": "nature-launcher",
  "version": "0.2.0",
  "description": "Minecraft launcher with Modrinth",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "build:installer": "node scripts/build-installer.js",
    "release": "node scripts/release.js"
  },
  "author": "Nature Launcher",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.nature.launcher",
    "productName": "Nature Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "mc.js",
      "preload.js",
      "version.txt",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  }
}